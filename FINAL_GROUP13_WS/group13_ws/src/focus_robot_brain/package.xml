<?xml version="1.0"?>
<package format="2">
  <name>focus_robot_brain</name>
  <version>0.1.0</version>
  <description>
    Decision node — session manager and LLM brain for the focus robot.
    Interprets voice commands, manages session lifecycle, and dispatches
    server commands to TTS and other actuators.
  </description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- HTTP client — apt: python3-requests -->
  <exec_depend>python3-requests</exec_depend>

  <export>
  </export>
</package>
