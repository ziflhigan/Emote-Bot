<launch>
  <!--
    Launch file for the Vision and Presence Detection Module.

    This node assumes /face_detection/faces is already being published
    by opencv_apps face_detection.launch. Start that BEFORE this one.

    Recommended launch order:
      Terminal 1:  roslaunch usb_cam usb_cam-test.launch
      Terminal 2:  roslaunch opencv_apps face_detection.launch image:=/usb_cam/image_raw
      Terminal 3:  roslaunch rchomeedu_vision user_state_monitor.launch
      Terminal 4:  rosrun  rchomeedu_vision print_user_state.py   (optional debug)

    Override examples:
      roslaunch rchomeedu_vision user_state_monitor.launch state_topic:=/vision_and_presence_detection
      roslaunch rchomeedu_vision user_state_monitor.launch face_topic:=/face_detection/faces

    Note: no soundplay_node is launched here, because this module does
    not speak. Audio output is the responsibility of other modules.
  -->

  <arg name="face_topic"  default="/face_detection/faces"/>
  <arg name="state_topic" default="/vision_and_presence_detection"/>

  <node name="user_state_monitor"
        pkg="rchomeedu_vision"
        type="user_state_monitor.py"
        output="screen">
    <param name="face_topic"  value="$(arg face_topic)"/>
    <param name="state_topic" value="$(arg state_topic)"/>
  </node>
</launch>
